# ==============================================================================
# 1. 目标硬件平台与机型定义 (Cudy TR3000 / 512MiB SPI-NAND 硬改)
# ==============================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-512mb-v1=y

# ==============================================================================
# 2. MT7981B / mt76 无线驱动与硬件固件
# ==============================================================================
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wireless-regdb=y

# ==============================================================================
# 3. LuCI 与简体中文
#    语言包统一用 -zh-cn：构建日志已确认 main/25.x 仍然是这个命名，
#    -zh_Hans 那一套不存在（写进去会被 defconfig 静默丢弃）。
# ==============================================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-theme-aurora=y
# 注意：luci-i18n-aurora-zh-cn / luci-i18n-openclash-zh-cn 这两个包在当前 feeds 里
# 不存在（defconfig 会静默丢弃并在构建日志告警），主题/OpenClash 自带中文目录，不需要它们。
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-i18n-aurora-config-zh-cn=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

# ==============================================================================
# 4. 内核模块
#    kmod-nft-offload / kmod-nf-flow：仅当 diy-part2.sh 里 F50_ACCEL=1 时启用，
#      当前 F50_ACCEL=0（TTL=65 优先），装进去但不会加载；确定不用加速可删。
#    kmod-tcp-bbr：BBR 拥塞控制，开机由 /etc/init.d/bbr 加载并应用。
# ==============================================================================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ==============================================================================
# 5. 实用系统工具
# ==============================================================================
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ==============================================================================
# 6. 中兴 F50 5G 随身 WiFi 免驱 USB 网卡协议栈 (RNDIS / ECM / NCM + 串口切换)
# ==============================================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_usb-modeswitch=y

# ==============================================================================
# 7. OpenClash 与 firewall4 / nftables 核心依赖
# ==============================================================================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y

# ==============================================================================
# 8. 运行时依赖（在线升级脚本 / OpenClash）
# ==============================================================================
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_jq=y
